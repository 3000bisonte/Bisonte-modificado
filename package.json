{
  "name": "nextjs-pwa-example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "node scripts/prebuild-verify.js && node scripts/prebuild-env-check.js && npm run build:plugin",
    "build": "next build",
    "build:plugin": "cd native/capacitor-bisonte-auth && npm run build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:pull": "prisma db pull --schema=prisma/schema.prisma",
    "db:reset": "prisma migrate reset --skip-seed --force --schema=prisma/schema.prisma",
    "db:status": "prisma migrate status --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@bisonte/capacitor-bisonte-auth": "file:native/capacitor-bisonte-auth",
    "@capacitor-community/admob": "^7.0.3",
    "@capacitor-firebase/authentication": "^7.3.1",
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@mercadopago/sdk-react": "^0.0.15",
    "@prisma/client": "^5.21.1",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "classnames": "^2.3.2",
    "dayjs": "^1.11.10",
    "envalid": "^8.1.0",
    "formik": "^2.2.9",
    "google-auth-library": "^9.14.1",
    "mercadopago": "^2.0.4",
    "mysql2": "^3.14.1",
    "next": "13.5.6",
    "next-auth": "^4.24.11",
    "pg": "^8.16.2",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^4.6.0",
    "yup": "^1.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.23.0",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10",
    "esbuild-register": "^3.6.0",
    "eslint": "^8",
    "eslint-config-next": "13.5.6",
    "postcss": "^8",
    "prisma": "^5.21.1",
    "tailwindcss": "^3",
    "typescript": "^5.9.2"
  }
}
