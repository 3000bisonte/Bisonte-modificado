{
  "extends": "./config/build/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/app/*": ["./src/app/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/components/*": ["./src/components/*"],
      "@/ui/*": ["./src/components/ui/*"],
      "@/forms/*": ["./src/components/forms/*"],
      "@/layout/*": ["./src/components/layout/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/utils/*": ["./src/lib/utils/*"],
      "@/hooks/*": ["./src/lib/hooks/*"],
      "@/services/*": ["./src/lib/services/*"],
      "@/api/*": ["./src/lib/api/*"],
      "@/config/*": ["./config/*"],
      "@/types/*": ["./types/*"],
      "@/constants/*": ["./src/constants/*"],
      "@/mobile/*": ["./mobile/*"],
      "@/native/*": ["./native/*"],
      "@/capacitor/*": ["./native/capacitor-*"],
      "@/tests/*": ["./tests/*"],
      "@/scripts/*": ["./scripts/*"],
      "@/docs/*": ["./docs/*"],
      "@/public/*": ["./public/*"],
      "@/assets/*": ["./public/assets/*"],
      "@/images/*": ["./public/images/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "archive/**/*",
    "mobile/android/**/*",
    "tests/**/*"
  ]
}
