{
  "name": "bisonte-logistica-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      ".",
      "native/capacitor-bisonte-auth"
    ]
  },
  "scripts": {
    "dev": "npm run dev --workspace=bisonte-logistica",
    "build": "npm run build --workspace=bisonte-logistica",
    "build:all": "npm run build && npm run build:plugin",
    "build:plugin": "npm run build --workspace=@bisonte/capacitor-bisonte-auth",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test --workspace=bisonte-logistica",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules .next out",
    "clean:install": "npm run clean && npm install",
    "postinstall": "npm run postinstall --workspaces --if-present",
    "workspace:info": "npm ls --workspaces",
    "workspace:outdated": "npm outdated --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.8.1"
}