# Example environment file (copy to .env.local for local dev)
# Secrets must be filled; values here are safe defaults or placeholders.

# Core
NODE_ENV=development
APP_VERSION=dev

# Database (Prisma)
# PostgreSQL example
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# NextAuth
# Local: http://localhost:3000
# Prod:  https://bisonteapp.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_long_random_string

# Google OAuth / Native token audience
# Use the "Web client" ID from Google Cloud Console. Known real ID (from repo/tests) left for convenience.
GOOGLE_CLIENT_ID=108242889910-n3ptem16orktkl0klv8onlttfl83r1ul.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@bisonteapp.com

# MercadoPago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
NEXT_PUBLIC_INIT_MERCADOPAGO=

# API URLs / CORS
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_SERVER_URL=
NEXT_PUBLIC_URL_BRICK_STATUS_SCREEN=
NEXT_PUBLIC_API_URL=
FALLBACK_API_BASE_URL=http://localhost:3000/api
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=true

# Ads (public)
NEXT_PUBLIC_ADMOB_APP_ID=
NEXT_PUBLIC_ADMOB_REWARDED_ID=
NEXT_PUBLIC_ADMOB_BANNER_ID=
# Optional Ads (web AdSense). Fill if using AdSense on web
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# NEXT_PUBLIC_ADSENSE_BANNER_SLOT=
# NEXT_PUBLIC_ADSENSE_RECT_SLOT=
# NEXT_PUBLIC_ADSENSE_RESP_SLOT=

# Security (legacy helpers)
# Optional legacy secrets (only for legacy flows)
# JWT_SECRET=
# TOKEN_SECRET=

# Diagnostics / Misc
# Set to 1 only in local/dev to enable POST /api/auth/verify-idtoken
ENABLE_IDTOKEN_VERIFY_ENDPOINT=0
RUNTIME_ENV=local
BASE_URL=http://localhost:3000/api
